{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MethodEntryDraft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "namespace",
    "kind",
    "name",
    "status",
    "origin",
    "definition",
    "source_refs",
    "rights",
    "verified_at",
    "related_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^method:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "namespace": {
      "type": "string",
      "minLength": 3
    },
    "kind": {
      "enum": [
        "method",
        "protocol",
        "mental_model",
        "standard",
        "research_pattern",
        "creative_pattern"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "expansion": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "proposed",
        "historical_assumption",
        "externally_documented",
        "reviewed",
        "deprecated"
      ]
    },
    "origin": {
      "enum": [
        "starlight_proposal",
        "conversation_derived",
        "notion_historical",
        "third_party"
      ]
    },
    "definition": {
      "type": "string",
      "minLength": 15
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "evidence_state"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "evidence_state": {
            "enum": [
              "inspected",
              "candidate_not_inspected"
            ]
          },
          "locator": {
            "type": "string"
          }
        }
      }
    },
    "rights": {
      "enum": [
        "original_proposed",
        "third_party_attribution_required",
        "review_required"
      ]
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
