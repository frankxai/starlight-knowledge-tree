{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://starlightintelligence.org/knowledge-tree/schemas/node.schema.json",
  "title": "KnowledgeTreeNode",
  "description": "A node in the Starlight Knowledge Tree graph",
  "type": "object",
  "required": [
    "id",
    "type",
    "label",
    "description",
    "domain",
    "tags",
    "status",
    "edges",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Unique node identifier in kebab-case, prefixed with type"
    },
    "type": {
      "type": "string",
      "enum": [
        "domain",
        "concept",
        "skill",
        "tool",
        "paper",
        "dataset",
        "experiment",
        "artifact",
        "credential",
        "open_problem",
        "contribution_task"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "domain": {
      "type": "string",
      "pattern": "^domain-[a-z][a-z0-9-]*$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 20
    },
    "status": {
      "type": "string",
      "enum": [
        "seed",
        "draft",
        "stable",
        "deprecated"
      ]
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "edge.schema.json"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "claim_class": {
      "type": "string",
      "enum": [
        "historical-source-claim",
        "scholarly-interpretation",
        "starlight-interpretation",
        "original-starlight-philosophy",
        "original-literary-mythic-material",
        "arcanea-fiction",
        "technical-operational"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "accessed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "fiction_boundary": {
      "type": "string",
      "minLength": 10
    }
  },
  "definitions": {
    "paper_fields": {
      "required": [
        "authors",
        "year",
        "url"
      ],
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "abstract": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "skill"
          }
        }
      },
      "then": {
        "required": [
          "prerequisites",
          "evidence_types",
          "unlock_criteria"
        ],
        "properties": {
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "explanation",
                "implementation",
                "public_artifact",
                "experiment_log",
                "reproducible_notebook",
                "contribution",
                "teaching_artifact"
              ]
            },
            "minItems": 1
          },
          "unlock_criteria": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "paper"
          }
        }
      },
      "then": {
        "required": [
          "authors",
          "year",
          "url"
        ],
        "properties": {
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "abstract": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "open_problem"
          }
        }
      },
      "then": {
        "required": [
          "difficulty",
          "prize_or_benchmark",
          "related_papers"
        ],
        "properties": {
          "difficulty": {
            "enum": [
              "accessible",
              "hard",
              "unsolved"
            ]
          },
          "prize_or_benchmark": {
            "type": [
              "string",
              "null"
            ]
          },
          "related_papers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "contribution_task"
          }
        }
      },
      "then": {
        "required": [
          "difficulty",
          "estimated_hours",
          "required_skills",
          "output_type"
        ],
        "properties": {
          "difficulty": {
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "estimated_hours": {
            "type": [
              "number",
              "null"
            ]
          },
          "required_skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_type": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_class": {
            "enum": [
              "historical-source-claim",
              "scholarly-interpretation"
            ]
          }
        },
        "required": [
          "claim_class"
        ]
      },
      "then": {
        "required": [
          "sources"
        ],
        "properties": {
          "sources": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_class": {
            "enum": [
              "original-literary-mythic-material",
              "arcanea-fiction"
            ]
          }
        },
        "required": [
          "claim_class"
        ]
      },
      "then": {
        "required": [
          "fiction_boundary"
        ]
      }
    }
  ]
}
