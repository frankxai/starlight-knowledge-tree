[
  {
    "id": "workflow-daily-ops",
    "type": "workflow",
    "label": "Daily Operations & Estate Sync",
    "description": "Morning synchronization workflow checking git worktree states, Linear issues, Notion Dev Hub status, storage health, and daily priority alignment.",
    "domain": "domain-ai-architect",
    "tags": ["workflow", "daily-ops", "estate-sync", "operations", "health-check"],
    "status": "evergreen",
    "trigger": "Manual / Morning Cron",
    "schedule": "08:30 Mon-Fri",
    "state_storage_path": "starlight/queen/reports/daily-ops.json",
    "pipeline_stages": [
      {
        "stage_num": 1,
        "name": "Estate Git Sweep",
